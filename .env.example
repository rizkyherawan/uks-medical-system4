# Salin file ini menjadi ".env" lalu sesuaikan isinya. JANGAN pernah mengunggah file .env ke GitHub.

# --- Server ---
PORT=3000
# development = nyaman untuk coba-coba | production = untuk server sungguhan (lebih ketat)
NODE_ENV=development

# --- Database MySQL / MariaDB (XAMPP / Laragon biasanya: user root, password kosong) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uks_pmr_wira

# --- Opsional ---
# Di belakang Nginx / Caddy / Cloudflare / hosting dengan proxy: isi 1 (jumlah proxy).
# Wajib agar alamat IP pengunjung dan status HTTPS terbaca benar.
# TRUST_PROXY=1

# Lokasi penyimpanan foto unggahan (isi folder tempat subfolder "uploads/konten" dibuat).
# Kosong = folder public/ di dalam proyek. Berguna bila server memakai disk permanen terpisah.
# UPLOAD_ROOT=

# Situs lain yang BOLEH mengirim data ke API ini (jarang perlu; pisahkan dengan koma).
# Biasanya cukup mengatur TRUST_PROXY dan header Host di proxy, tanpa mengisi ini.
# ALLOWED_ORIGINS=https://uks.contoh.sch.id

# Batas permintaan per IP (sekolah biasanya berbagi satu IP publik, jadi jangan terlalu kecil)
# API_RATE_MAX=600
# LOGIN_RATE_MAX=200
# REGISTER_RATE_MAX=80

# Hanya untuk uji coba di mode production: izinkan kata sandi awal. JANGAN dipakai di server sungguhan.
# ALLOW_DEFAULT_PASSWORDS=false
